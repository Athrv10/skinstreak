# Copy this file to .env (project root) and fill in real values.
# Used by the backend — see backend/database.py, auth_utils.py, email_service.py.

DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
APP_URL=http://localhost:5173

# Comma-separated list of origins allowed to call this API.
# For production, set this to your deployed frontend URL(s), e.g.:
# ALLOWED_ORIGINS=https://skinstreak.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Storage — used to persist uploaded progress photos so they
# survive backend redeploys (Render/Railway wipe local disk on redeploy).
# Find these in the Supabase dashboard: Project Settings -> API.
# If left unset, photos fall back to local disk under backend/uploads/
# (fine for local dev, NOT durable in production).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_STORAGE_BUCKET=progress-photos
