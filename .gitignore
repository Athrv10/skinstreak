# ─── Environment Variables ──────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.venv/
venv/
ENV/

# ─── User-uploaded content ──────────────────────────────────────────────────────
# Progress photos are personal data and shouldn't be committed to version control.
backend/uploads/*
!backend/uploads/.gitkeep

# ─── Node / Frontend ────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ─── Local tool caches ──────────────────────────────────────────────────────────
.sf/

# ─── IDE / OS ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Logs ───────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ─── Misc ───────────────────────────────────────────────────────────────────────
*.bak
*.tmp
