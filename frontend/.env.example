# Copy this file to .env (frontend/) and fill in real values.

# Base URL of the backend API. For local dev this is the FastAPI server.
# For production (Vercel), set this as a Vercel project environment
# variable pointing to your deployed Render/Railway backend URL, e.g.:
# VITE_API_BASE_URL=https://skinstreak-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8000
